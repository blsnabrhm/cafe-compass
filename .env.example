# Café Compass Environment Configuration Example
# Copy this file to .env.local

# 1. Google Cloud Project ID hosting your Firestore (default) database
GCP_PROJECT_ID=builderpopup-511309

# 2. Path to your downloaded service account key (optional if using 'gcloud auth application-default login')
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 3. Gemini API Keys (Managed automatically in Cloud Run via Secret Manager)
# GEMINI_API_KEY_MAYA=...
# GEMINI_API_KEY_LEO=...
# GEMINI_API_KEY_SAM=...
# GEMINI_API_KEY=...

# 4. Staff Management Security PIN
STAFF_PIN=1984
